FROM timurml/tensorrt.8.5.3:latest

SHELL ["/usr/bin/bash", "-c"]

# ros uses opencv 4.2, base has opencv 4.5 installed, remove it
# it has to be done, i've ran into terrible runtime problems
RUN <<EOT
    cd /home/opt/workspace/opencv-4.5.4/release
    cmake --build . --target uninstall
    cd /
    rm -rf /home/opt
EOT

RUN echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list

RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -

RUN <<EOT
    apt-get update;
    xargs apt-get install -y \
        curl wget screen build-essential cmake \
        git nano screen ros-noetic-ros-base \
        python3-pip python3-catkin-tools python3-venv \
        python3-rosdep python3-rosinstall \
        python3-rosinstall-generator python3-wstool;
    rm -rf /var/lib/apt/lists/*
EOT

